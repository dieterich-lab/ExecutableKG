# Copy to .env, fill in, then load it with:  set -a; source .env; set +a
# Never commit .env.

# --- Neo4j (graph build and KG query)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# leave empty for the server's default database
NEO4J_DATABASE=

# --- Ollama embeddings (KG grounding indexes and VectorRAG; native API, a trailing /v1 is accepted)
OLLAMA_EMBED_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:4b

# --- LLM for KG steps (i) and (iv): OpenAI-compatible endpoint that serves qwen3:32b
KG_LLM_BASE_URL=http://localhost:11434/v1
# Optional settings of the KG query modules:
# KG_LLM_CACHE=results/kg_rerun/llm_cache.jsonl   LLM answer cache (default: results/llm_cache.jsonl)
# KG_STRICT_LLM=1                                  a failed formatter call fails the case (default 1)
# KG_FILTERS=certainty,negation,qualifier          step (v) checks; add absence, or none to skip step (v)

# --- VectorRAG generators
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:32b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional: your own SNOMED CT release in PostgreSQL (synonyms in the grounding text)
SNOMED_DB_HOST=localhost
SNOMED_DB_PORT=5432
SNOMED_DB_USER=snomed
SNOMED_DB_PASSWORD=
SNOMED_DB_NAME=snomed
SNOMED_DB_SSLMODE=prefer
SNOMED_DB_SSLROOTCERT=
