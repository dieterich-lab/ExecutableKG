{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/vectorrag/gold-standard-record.schema.json",
  "title": "VectorRAG gold-standard case record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "patient_case": {
      "type": "string",
      "minLength": 1
    },
    "expected_row_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": ["string", "null"]
    }
  },
  "required": ["schema_version", "case_id", "patient_case", "expected_row_ids"]
}
